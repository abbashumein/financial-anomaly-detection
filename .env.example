GROQ_API_KEY=your_groq_key_here
EDGAR_USER_AGENT=your-app/1.0 ([email protected])

# Optional. Defaults to openai/gpt-oss-120b (Groq's current recommended
# replacement for llama-3.3-70b-versatile, deprecated 2026-06-17). If
# Groq deprecates this one too, just change it here - no code edit needed.
GROQ_MODEL=

# Optional. If unset, the API runs WITHOUT auth (fine for local dev).
# Set this for any public/demo deployment to require the X-API-Key
# header on /analyze.
API_KEY=
